---
// Temporary page for visually verifying <ListingCard />. Safe to delete.
import '../styles/global.css';
import { client } from '../sanity/lib/client';
import ListingCard, { type Listing } from '../components/ListingCard.astro';

const listings = await client.fetch<Listing[]>(
  `*[_type == "listing"]{
    _id, title, slug, description, price, currency, status, images, category,
    details[]{ _key, label, value, valueType, valueNumber, unit, valueBoolean, valueDate },
    listingDate
  } | order(listingDate desc)`,
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ListingCard test</title>
  </head>
  <body class="bg-white p-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {listings.map((listing) => <ListingCard listing={listing} />)}
    </div>
  </body>
</html>
